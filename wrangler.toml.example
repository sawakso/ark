# 仅供本地开发使用（这个文件不会被提交，需要的同学复制成 wrangler.toml）
#
#   cp wrangler.toml.example wrangler.toml
#   npm run dev
#
# 【重要】线上部署不要带 wrangler.toml：
#   一旦仓库根目录存在 wrangler.toml，Cloudflare Pages 会用它【覆盖】后台的构建设置，
#   而且 name 必须和 Pages 项目名一致，否则部署会报错。
#   线上直接在后台上配「构建输出目录 = /」和 KV 绑定即可，更省事也更安全。

name = "ark-tools"
pages_build_output_dir = "."
compatibility_date = "2025-09-01"

# KV：命名空间叫 ARK-DATA，代码里用变量名 ARK_DATA
# 注意：`wrangler pages dev` 不认下面这段配置，必须用命令行参数：
#   npx wrangler pages dev . --kv ARK_DATA     （已写进 npm run dev）
# 这里的 id 只对 `--remote` 模式有用。
[[kv_namespaces]]
binding = "ARK_DATA"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
preview_id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

# 可选：想把新干员的图片也镜像到 R2 时再启用（当前版本没用到）
# [[r2_buckets]]
# binding = "ARK_IMAGES"
# bucket_name = "ark-images"

# UPDATE_PASSWORD 不要写在这里（会被提交到 git），放到 .dev.vars
